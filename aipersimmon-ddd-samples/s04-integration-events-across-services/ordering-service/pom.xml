<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.example.samples</groupId>
    <artifactId>s04-integration-events-across-services</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>s04-ordering-service</artifactId>
  <name>s04-ordering-service</name>
  <description>The publishing side: a business row and an outbox row in one transaction.</description>

  <dependencies>
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-persistence-mybatis-plus</artifactId>
    </dependency>
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-mybatis-plus-spring-boot-starter</artifactId>
    </dependency>
    <!--
      The durable side. This one artifact carries the outbox port, the engine, its Spring starter and
      ShedLock (the relay's cleanup lease) — so "make publication survive a crash" is one dependency,
      not five. It also brings the migrations for the outbox tables; putting them on the classpath is
      NOT the same as creating them, which is what aipersimmon.ddd.flyway.components decides.
    -->
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-outbox-mybatis-plus</artifactId>
    </dependency>
    <!-- The transport. Adding it is what turns @Externalized from "unreachable" into "routed". -->
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-starter-messaging-kafka</artifactId>
    </dependency>
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-flyway-spring-boot-starter</artifactId>
    </dependency>
    <!--
      S13, hosted here. Two artifacts, because tenancy is two separable jobs: resolving the tenant at
      the edge and binding it (the starter), and rewriting SQL so a query cannot leave its tenant (the
      MyBatis-Plus one). Both are inert until aipersimmon.ddd.tenancy.enabled=true.
    -->
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-tenancy-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-tenancy-mybatis-plus</artifactId>
    </dependency>
    <!--
      S15, hosted here. This is the artifact that fills the outbox row's traceparent/trace_state
      columns: they exist without it and stay null, because capture goes through an SPI whose default
      implementation captures nothing. Installing it also brings OpenTelemetry's own Spring Boot
      starter (HTTP/JDBC/Kafka auto-instrumentation and the OpenTelemetry bean).
    -->
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-observability-otel-spring-boot-starter</artifactId>
    </dependency>

    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
    </dependency>
    <!--
      The one dependency the tenancy module cannot bring for you. Since MyBatis-Plus 3.5.9 the
      SQL-parsing inner interceptors live in this separate artifact, and aipersimmon-ddd-tenancy-
      mybatis-plus declares it `provided` on purpose — it must not force jsqlparser onto a consumer
      that never parses SQL. Omit it with tenancy enabled and startup fails with
      NoClassDefFoundError: TenantLineHandler, which is loud, and is the last word on the subject
      before anything runs. (Not mentioned in CHOOSING-MODULES.md; the crash is the documentation.)
    -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-jsqlparser</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-archunit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-test-support</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>kafka</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
