  <artifactId>s04-integration-events-across-services</artifactId>
  <packaging>pom</packaging>
  <name>s04-integration-events-across-services</name>
  <description>S4: one fact, two deployables — outbox, Kafka, inbox.</description>

  <!--
    Two services, two modules, and deliberately NO third module holding the event class.

    They are separate deployables, so a shared contract jar would give them a compile-time coupling
    that the deployment boundary is supposed to remove: bump the jar and both sides must be released
    together, which is the thing a broker was introduced to avoid. The library is built for the other
    way round — an event resolves by its logical (name, version) pair from @EventType, never by Java
    class — so each side declares its own class for the same contract, and the consumer's copy carries
    only the fields it actually reads.
  -->
  <modules>
    <module>ordering-service</module>
    <module>inventory-service</module>
  </modules>
</project>
