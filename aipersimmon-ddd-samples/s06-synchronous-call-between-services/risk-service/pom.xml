<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.example.samples</groupId>
    <artifactId>s06-synchronous-call-between-services</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>s06-risk-service</artifactId>
  <name>s06-risk-service</name>
  <description>The callee: a decision service that owns no database.</description>

  <!--
    The bundle for a service with no database, which is the catalogue's question and has a short answer:
    aipersimmon-ddd-starter, and nothing else from the framework.

    No -persistence-*, no -outbox-*, no -inbox-*, no -flyway-*: every one of those exists to make a
    database do something. What is left is still worth having — the command/query buses, the interceptor
    chain, id generation, and the web layer's RFC 9457 problem responses, which is exactly what a callee
    needs in order to be callable politely.

    One property comes with it, and it is not optional: with no DataSource there is no transaction
    manager, and the starter refuses to start rather than let its "one command, one transaction"
    guarantee evaporate silently. See application.yaml.
  -->
  <dependencies>
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-starter</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-archunit</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
