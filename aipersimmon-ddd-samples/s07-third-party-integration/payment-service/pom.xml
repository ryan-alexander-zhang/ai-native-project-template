<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.example.samples</groupId>
    <artifactId>s07-third-party-integration</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>s07-payment-service</artifactId>
  <name>s07-payment-service</name>
  <description>Our side: durable intent out, signed callbacks in, and a pull channel for the rest.</description>

  <dependencies>
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-persistence-mybatis-plus</artifactId>
    </dependency>
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-mybatis-plus-spring-boot-starter</artifactId>
    </dependency>
    <!--
      The outbox, used here for something it was not named after: the durable intent to call a third
      party. The row is written in the command's transaction, the relay leases it, retries it with
      backoff and dead-letters it after max-attempts — all of which an outbound payment request needs
      and none of which is specific to a broker. What it costs is stated in the README: one dispatcher
      per application, and a relay that cannot record an answer.
    -->
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-outbox-mybatis-plus</artifactId>
    </dependency>
    <!--
      The edge protections for the inbound callback. S2 covers what each one does; the reason this
      sample takes them is narrower: a callback endpoint is an unauthenticated POST from the public
      internet, and a signature check is the only thing standing between it and anyone.
    -->
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-web-spring-boot-starter</artifactId>
    </dependency>
    <!--
      The store behind the replay guard, and the one documented departure from "MyBatis-Plus only" in
      these samples: the library ships web-store-jdbc and web-store-redis, and there is no MyBatis-Plus
      variant. S2 took Redis; this one takes JDBC, so the pair is covered across the two samples. It
      needs no extra infrastructure — the nonce table lives in the database that is already here — and
      it brings a startup schema validator and a retention scheduler that Redis gets from TTLs.
    -->
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-web-store-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-flyway-spring-boot-starter</artifactId>
    </dependency>

    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      The provider's "SDK", on the test classpath only. Scope is the whole design statement: main code
      that cannot see these classes cannot accidentally pass one inward, and an ArchUnit rule that says
      so is then enforcing something the build already guarantees.
    -->
    <dependency>
      <groupId>com.example.samples</groupId>
      <artifactId>s07-gateway-stub</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-archunit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-test-support</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
