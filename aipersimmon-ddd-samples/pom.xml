<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Parent and aggregator for the aipersimmon-ddd samples. One reactor on purpose: a sample that
    builds only when someone remembers to build it rots. `mvn verify` here covers every sample.
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.10</version>
    <relativePath/>
  </parent>

  <groupId>com.example.samples</groupId>
  <artifactId>aipersimmon-ddd-samples</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>aipersimmon-ddd-samples</name>
  <description>Runnable samples, one per DDD flow scenario.</description>

  <properties>
    <java.version>21</java.version>
    <aipersimmon-ddd.version>0.2.0-SNAPSHOT</aipersimmon-ddd.version>
    <mybatis-plus.version>3.5.15</mybatis-plus.version>
  </properties>

  <modules>
    <module>s01-http-command-query</module>
    <module>s02-http-idempotency</module>
    <module>s03-domain-events-in-process</module>
    <module>s04-integration-events-across-services</module>
    <module>s05-external-messages-inbound</module>
    <module>s06-synchronous-call-between-services</module>
    <module>s07-third-party-integration</module>
    <module>s08-local-transaction-aggregate</module>
    <module>s09-eventual-consistency-process-manager</module>
    <module>s10-strong-consistency-seata</module>
    <module>s11-scheduled-and-batch-entries</module>
    <module>s12-cqrs-read-model</module>
    <module>s16-tactical-modelling</module>
    <module>s17-aggregate-persistence-mapping</module>
    <module>s18-testing-strategy</module>
    <module>s19-validation-layers</module>
    <module>s20-query-contract-paging</module>
    <module>s21-event-contract-evolution</module>
    <module>s22-operability-deadletters-retention</module>
    <module>s23-schema-migration</module>
    <module>s24-add-bounded-context</module>
    <module>s25-strangler-legacy-adoption</module>
    <module>s26-read-side-caching</module>
    <module>s27-soft-delete-and-erasure</module>
    <module>s28-long-running-endpoints</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <!--
        Import order is load-bearing. This BOM carries the OpenTelemetry core line the optional
        observability starter needs, which spring-boot-dependencies manages to an older one; the
        first import of a coordinate wins, and entries declared here outrank the ones inherited
        from spring-boot-starter-parent. So this must come first, and it must stay a sibling of
        (never a replacement for) Spring Boot's own dependency management.
      -->
      <dependency>
        <groupId>com.aipersimmon.ddd</groupId>
        <artifactId>aipersimmon-ddd-bom</artifactId>
        <version>${aipersimmon-ddd.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- MyBatis-Plus is the consumer's choice of persistence: neither Spring Boot nor the
           aipersimmon BOM versions it. -->
      <dependency>
        <groupId>com.baomidou</groupId>
        <artifactId>mybatis-plus-bom</artifactId>
        <version>${mybatis-plus.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
