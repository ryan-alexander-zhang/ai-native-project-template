<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.example.samples</groupId>
    <artifactId>aipersimmon-ddd-samples</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>s01-http-command-query</artifactId>
  <name>s01-http-command-query</name>
  <description>S1: one HTTP write and one HTTP read, from controller to committed row.</description>

  <dependencies>
    <!--
      The smallest dependency set for HTTP -> command -> aggregate -> save, plus the operation log
      (scenario S14 is hosted here).

      Still deliberately NOT aipersimmon-ddd-starter-mybatis-plus: that bundle also brings the
      outbox, inbox and process-manager modules, each of which registers a schema validator that
      runs whenever a SqlSessionFactory exists — and this sample owns exactly one framework table,
      the audit log. Taking the bundle would mean either declaring three more components in
      aipersimmon.ddd.flyway.components and carrying tables nothing writes to, or a startup failure
      on the first missing one.
    -->
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-starter</artifactId>
    </dependency>
    <!--
      S14, hosted here. Two artifacts, because the operation log is two separable jobs: capturing an
      operation around the command boundary (-cqrs, the interceptors and the annotation compiler) and
      storing the row (-mybatis-plus, the sink and the retention purge). A service that wanted to send
      audit rows somewhere else would keep the first and replace the second.
    -->
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-operation-log-cqrs-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-operation-log-mybatis-plus</artifactId>
    </dependency>
    <!-- The audit table's DDL ships inside the component's jar, so the framework's migrator has to
         run: see aipersimmon.ddd.flyway.components in application.yaml. -->
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-flyway-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-persistence-mybatis-plus</artifactId>
    </dependency>
    <!-- Owns the single MybatisPlusInterceptor and orders every InnerInterceptor contribution,
         including the optimistic locker the persistence module contributes. -->
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-mybatis-plus-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-openapi-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
    </dependency>

    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The layering and building-block rules, run over this sample's own packages. Not optional:
         versionWitnessIsAdvancedOnlyByPersistenceAdapters is the only thing stopping business code
         from calling versionAdvanced() and disarming the optimistic lock. -->
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-archunit</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Singleton Testcontainers + @ServiceConnection configs. -->
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-test-support</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
