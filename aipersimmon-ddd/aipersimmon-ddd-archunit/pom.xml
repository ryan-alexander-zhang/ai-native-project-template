<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.aipersimmon.ddd</groupId>
    <artifactId>aipersimmon-ddd-parent</artifactId>
    <version>0.1.0</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <!--
    Reusable ArchUnit rules and structural checks that verify DDD layering and
    building-block conventions. A consumer adds this module at test scope and
    gets both the rules and ArchUnit's JUnit 5 support (@AnalyzeClasses, @ArchTest)
    transitively.

    Depends on aipersimmon-ddd-core, aipersimmon-ddd-integration, aipersimmon-ddd-application,
    and aipersimmon-ddd-cqrs so rules can reference the building-block types they
    guard (the domain-event and integration-event markers, the @DomainEventHandler
    marker, and the CommandHandler contract). ArchUnit is a compile dependency here
    so it flows to the consumer's test classpath. Spring is a test-only dependency,
    used solely by the fixtures that exercise the @EventListener placement rules; the
    rules themselves match @EventListener by name and carry no compile dependency on Spring.
  -->
  <artifactId>aipersimmon-ddd-archunit</artifactId>
  <name>aipersimmon-ddd-archunit</name>
  <description>Reusable ArchUnit rules and structural checks enforcing DDD layering and building-block conventions.</description>

  <dependencies>
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-integration</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- For the @DomainEventHandler marker referenced by the event-subscriber rules. -->
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-application</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- For the CommandHandler contract referenced by the handler-dependency rule. -->
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-cqrs</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
    </dependency>
    <!-- The remaining contract modules, at test scope only, so ContractModulesCarryNoFrameworkTest
         can read their bytecode off this module's test classpath. Test scope keeps them out of
         what a consumer of this artifact receives; Maven's dependency ordering guarantees they are
         built before this module's tests run, which reading target/ directories by path would not.
         (core, integration, application and cqrs are already compile dependencies above, because
         the rules reference their types.) -->
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-tenancy</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-observability</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-inbox</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-outbox</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-operation-log</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-process-manager</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-web</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Test only: @TransactionalEventListener, which lives here rather than in spring-context. The
         event-listener rules match @EventListener by name including as a meta-annotation, and this
         is the annotation that carries it that way — so the fixtures need the real thing for the
         meta-annotated case to be measured rather than simulated. Still never a compile dependency:
         the rules name Spring's annotation as a string. -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-tx</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Test only: fixtures that carry the @OperationLog annotation and (mis)use the component, so
         the OperationLogRules have real classes to accept and reject. The rules themselves match the
         annotation and the operationlog packages by name, so this is never a compile dependency —
         the rules jar stays free of the component and does not drag it onto a consumer's classpath. -->
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-operation-log</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Test only: a fixture that (wrongly) annotates an application-tier read model with an OpenAPI
         schema annotation, so domainAndApplicationShouldNotDependOnApiDocumentation has a real
         violation to catch. Never a compile dependency — the rule exists to keep this jar off the
         inner tiers. -->
    <dependency>
      <groupId>io.swagger.core.v3</groupId>
      <artifactId>swagger-annotations-jakarta</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Test only: fixtures carrying MyBatis / MyBatis-Plus markers, so PersistenceRules has a real
         mapper and a real mapped row to place. The rules match both by name, so this is never a
         compile dependency — the whole point is that the rules jar does not put a persistence
         technology on a consumer's classpath. -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-annotation</artifactId>
      <version>${mybatis-plus.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-core</artifactId>
      <version>${mybatis-plus.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Test only: a fixture @RestController with a mapped endpoint, so WebRules has a real
         signature to read and a real @GetMapping to tell an endpoint from a private helper. Matched
         by name by the rule, so never a compile dependency. -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-web</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Test only: fixtures carrying Bean Validation constraints, so
         commandComponentsShouldDeclareValidationConstraints has a compliant command to accept.
         The rule itself matches the annotations by name, so this is never a compile dependency. -->
    <dependency>
      <groupId>jakarta.validation</groupId>
      <artifactId>jakarta.validation-api</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
