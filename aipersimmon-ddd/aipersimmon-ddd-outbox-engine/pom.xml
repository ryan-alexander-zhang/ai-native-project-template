<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.aipersimmon.ddd</groupId>
    <artifactId>aipersimmon-ddd-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <!--
    The storage-agnostic engine of the transactional outbox: the writer, the relay (ordering,
    classification, backoff, dead-lettering), the scheduled lease-guarded trigger, the retention
    cleanup, and the shared Spring wiring — everything that is NOT tied to a particular database. It
    runs against one store port (OutboxStore); a storage backend (aipersimmon-ddd-outbox-jdbc,
    aipersimmon-ddd-outbox-mybatis-plus) supplies the adapter.

    Why it exists: the relay is the most concurrency-sensitive code in the framework — per-aggregate
    ordering under partial failure, a retry budget that must not be spent by a mark-sent failure, a
    dead-letter move that must survive its own store being down — and it used to be maintained twice,
    once per backend, with the scheduler byte-identical between them. Two copies of that reasoning is
    one copy too many: a fix to either is a silent divergence in the other. This is the same
    engine-over-store-ports shape aipersimmon-ddd-process-manager-engine and
    aipersimmon-ddd-operation-log-engine already use.

    It depends on Spring tx / context / boot-autoconfigure (the writer must assert the caller's
    transaction, and the beans need an auto-config seam) but NOT on spring-jdbc or any ORM. One thing
    deliberately stays with the backends: the ShedLock LockProvider, which is a JDBC lock table and
    therefore genuinely storage-specific — the engine only declares that the poll holds a lease.
  -->
  <artifactId>aipersimmon-ddd-outbox-engine</artifactId>
  <name>aipersimmon-ddd-outbox-engine</name>
  <description>Storage-agnostic engine of the transactional outbox: writer, relay, scheduler, cleanup, and shared Spring wiring over one store port.</description>

  <dependencies>
    <!-- The UUIDv7 IdGenerator implementation, at runtime scope: this module compiles against the
         IdGenerator SPI in aipersimmon-ddd-core and never names anything in this starter, but the
         bean has to exist or the framework mints ids with UUID.randomUUID() and reintroduces the
         random-key write amplification the SPI was added to remove — with no startup signal. Runtime scope says exactly that and still reaches the application's
         classpath transitively; compile scope claimed a code dependency that was never there. -->
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-id-spring-boot-starter</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <!-- The outbox contracts: OutboxMessage, OutboxDispatcher, DeadLetterStore, FailureClassifier,
         RetryBackoff. -->
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-outbox</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- OutboxProperties and the storage-agnostic dispatcher selection, which this engine's beans
         read and order themselves after. -->
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-outbox-spring-boot-starter</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- DurableIntegrationEvents: the port the writer implements. -->
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-application</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- EventEnvelope / IntegrationEvent: the wire identity the writer stamps onto a row. -->
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-integration</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Observability SPI (framework-free, no-op by default): the relay restores the writing
         thread's trace context around each dispatch. -->
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-observability</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Metrics are an optional seam: the observer and backlog reads are framework-free, and the
         Micrometer beans bind only when a MeterRegistry is present. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-core</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- The writer serializes the event payload to JSON. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- TransactionSynchronizationManager (the writer's atomicity assertion) and
         DuplicateKeyException (the idempotent insert). No spring-jdbc. -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-tx</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <!-- @SchedulerLock on the poll: one instance relays at a time. The LockProvider itself is a
         backend's concern. -->
    <dependency>
      <groupId>net.javacrumbs.shedlock</groupId>
      <artifactId>shedlock-spring</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!--
    The engine is where the outbox's judgements live and where a mistake is a lost or duplicated
    message, so this is where the coverage gate belongs. It used to have neither tests nor a gate
    while the pure value-type modules had both — the gates sat where the risk was not.

    The runtime packages are gated; `autoconfigure` is excluded, because it is Spring wiring whose
    only meaningful test is a context that actually starts, and both storage backends already boot
    one. Covering it here would need a Spring context in a module deliberately built without one,
    to re-prove what the backends prove against a real database.

    Storage-free and Docker-free, so the gate stays CI-portable. prepare-agent and report come
    from the parent's pluginManagement; check and mutationCoverage are declared here.
  -->
  <build>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>jacoco-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <excludes>
                <exclude>com/aipersimmon/ddd/outbox/engine/autoconfigure/**</exclude>
              </excludes>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.90</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.80</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!--
        Mutation testing, scoped to the runtime packages. The thresholds are 85 rather than the
        90 the pure-tier modules use, and the difference is the point rather than an exemption:
        every mutant still alive here is one whose death would mean asserting something no
        behaviour depends on — a log statement's `if (deleted > 0)` guard, latency arithmetic fed
        to a metrics hook, a private helper's return value where the mutated version fails the
        dispatch by a different route and lands in the same place. Writing those assertions would
        raise the number and defend nothing, so the number says what is true instead. Ratchet it
        up when real coverage rises, not to make it look tidier.

        It is worth having at all because it has already earned its keep: the first run found
        three genuinely untested paths, including a hand-over that throws before the transport
        takes the message, which line coverage called covered.
      -->
      <plugin>
        <groupId>org.pitest</groupId>
        <artifactId>pitest-maven</artifactId>
        <configuration>
          <mutationThreshold>85</mutationThreshold>
          <testStrengthThreshold>85</testStrengthThreshold>
          <coverageThreshold>85</coverageThreshold>
          <targetClasses>
            <param>com.aipersimmon.ddd.outbox.engine.relay.*</param>
            <param>com.aipersimmon.ddd.outbox.engine.write.*</param>
            <param>com.aipersimmon.ddd.outbox.engine.cleanup.*</param>
            <param>com.aipersimmon.ddd.outbox.engine.observe.*</param>
          </targetClasses>
        </configuration>
        <executions>
          <execution>
            <id>pit-mutation-coverage</id>
            <phase>verify</phase>
            <goals>
              <goal>mutationCoverage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
