<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.aipersimmon.ddd</groupId>
    <artifactId>aipersimmon-ddd-parent</artifactId>
    <version>0.1.0</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <!--
    Storage-agnostic inbox module, symmetrical with aipersimmon-ddd-outbox: it owns the Inbox
    contract (the idempotency guard a consumer calls before handling a message) and the shared
    table schema both adapters write to. Zero dependencies, so a consuming application can
    depend on the port without choosing JDBC or MyBatis-Plus.

    The schema is the vendor-templated Flyway migrations under
    aipersimmon/db/migration/inbox/{vendor}: the -inbox-mybatis-plus adapter uses
    an IDENTICAL table, so it lives here in exactly one place and is on the classpath whichever
    adapter is used. Applied automatically by the optional aipersimmon-ddd-flyway-spring-boot-starter starter, or
    copied into the consumer's own Flyway/Liquibase.
  -->
  <artifactId>aipersimmon-ddd-inbox</artifactId>
  <name>aipersimmon-ddd-inbox</name>
  <description>Storage-agnostic inbox contract and shared table schema for the JDBC and MyBatis-Plus inbox adapters.</description>

</project>
