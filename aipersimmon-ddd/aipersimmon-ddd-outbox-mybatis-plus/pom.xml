<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.aipersimmon.ddd</groupId>
    <artifactId>aipersimmon-ddd-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <!--
    Transactional-outbox storage over MyBatis-Plus. It implements the
    integration-event publisher port by inserting a row into an outbox table in the
    caller's transaction (atomic with the aggregate change) through a MyBatis-Plus
    BaseMapper, and a scheduled relay dispatches unsent rows through the
    OutboxDispatcher from the storage-agnostic outbox core and marks them sent.

    For projects standardized on MyBatis-Plus: the outbox uses the same
    SqlSessionFactory, DataSource, and transaction manager as the rest of the
    persistence. It registers ONLY its own mapper (via a MapperFactoryBean), so it
    never triggers or hijacks the consumer's @MapperScan, and defines no JPA
    @Entity. The consumer creates the outbox table (a documented DDL).

    Delivery is at-least-once: a crash between dispatch and marking a row sent
    causes a redelivery, so consumers must be idempotent (see the inbox). This is
    the only outbox storage backend the library ships; include exactly one
    outbox storage starter. A broker starter (aipersimmon-ddd-messaging-kafka)
    plugs into either because both share the outbox core's dispatcher contract.
  -->
  <artifactId>aipersimmon-ddd-outbox-mybatis-plus</artifactId>
  <name>aipersimmon-ddd-outbox-mybatis-plus</name>
  <description>Transactional-outbox storage over MyBatis-Plus for reliable integration-event delivery.</description>

  <dependencies>
    <!-- Observability SPI (framework-free, no-op default): capture on write, restore on dispatch. -->
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-observability</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-outbox</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The Spring assembly half of the outbox: OutboxProperties, the shared
         auto-configuration this module orders against, and the in-process dispatcher.
         The contracts come from -outbox, which is Spring-free. -->
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-outbox-spring-boot-starter</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The storage-agnostic engine: writer, relay, schedule and cleanup. This module supplies only
         the OutboxStore adapter it runs on, so the delivery logic exists once for both backends. -->
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-outbox-engine</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-application</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-integration</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- ShedLock: runs the scheduled relay on a single instance at a time so a
         multi-instance deployment does not poll and dispatch the same rows N times. -->
    <dependency>
      <groupId>net.javacrumbs.shedlock</groupId>
      <artifactId>shedlock-spring</artifactId>
    </dependency>
    <dependency>
      <groupId>net.javacrumbs.shedlock</groupId>
      <artifactId>shedlock-provider-jdbc-template</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The observability seam is exercised here rather than in the engine, which has no test
         harness of its own: Micrometer is optional there and test-scoped here. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Real-engine coverage for the claim SQL: the head-of-subject NOT EXISTS predicate and the
         CAS lease UPDATE rest on engine-specific semantics that H2 cannot vouch for. -->
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-test-support</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>mysql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
