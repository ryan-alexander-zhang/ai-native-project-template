<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.aipersimmon.ddd</groupId>
    <artifactId>aipersimmon-ddd-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <!--
    Aggregate persistence for MyBatis-Plus: a template-method repository base that makes the
    version-checked write and the domain-event drain the default path rather than something each
    consumer repository re-implements (design-00011 §2), plus the OptimisticLockerInnerInterceptor
    contribution that supplies the WHERE version = ? predicate.

    Deliberately provides NO generic repository port: the domain defines its own (Orders, Stocks),
    and a framework-imposed AggregateRepository<A, ID> would drag findAll/update-style operations
    into the domain language.
  -->
  <artifactId>aipersimmon-ddd-persistence-mybatis-plus</artifactId>
  <name>aipersimmon-ddd-persistence-mybatis-plus</name>
  <description>Version-checked aggregate repository base and optimistic-locker contribution for MyBatis-Plus.</description>

  <dependencies>
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-application</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-mybatis-plus</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- BaseMapper + OptimisticLockerInnerInterceptor. provided for the same reason as the other
         MyBatis-Plus modules: the app brings the starter. -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-extension</artifactId>
      <version>${mybatis-plus.version}</version>
      <scope>provided</scope>
    </dependency>
    <!-- OptimisticLockingFailureException lives in org.springframework.dao (spring-tx). -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-tx</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- A real MyBatis-Plus runtime (SqlSessionFactory + auto-config) and H2 for the assembly and
         behaviour tests. The starter, not a second mybatis-plus-extension entry: declaring the same
         coordinate twice would let the test scope override the provided one and take it off the main
         compile classpath. -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

</project>
