      <!-- The one third-party BOM this one re-exports, and the exception that shows the rule.
           It is here because the optional observability-otel starter's instrumentation is built
           against this core OpenTelemetry line, and Spring Boot manages opentelemetry-api to an
           older one: without this, the starter fails at boot with NoClassDefFoundError
           io.opentelemetry.common.ComponentLoader. That is a promise this library can actually
           keep — its own starter does not work on another line — which is what separates it from
           the Spring Boot / Jackson / JUnit pins that used to arrive here through the parent.
           Import order in the consumer decides the winner, so this BOM must precede the Spring
           Boot BOM there. Inert for consumers that do not use the OTEL starter
           (dependencyManagement adds no dependency).
           Version literal: keep in step with opentelemetry.version in aipersimmon-ddd-parent. -->
      <dependency>
        <groupId>io.opentelemetry</groupId>
        <artifactId>opentelemetry-bom</artifactId>
        <version>1.63.0</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
