      <!-- OpenAPI/Swagger, re-exported for the same reason as the OpenTelemetry line: the
           annotation jar is what a consumer's adapter tier compiles against at `provided` scope,
           and `provided` is not transitive — so without a managed version here the consumer would
           have to pin it by hand and could drift from the springdoc runtime the openapi starter
           brings in transitively. Neither is managed by spring-boot-dependencies, so nothing else
           would align them.
           Version literals: keep in step with springdoc.version / swagger.version in
           aipersimmon-ddd-parent. -->
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>2.8.9</version>
      </dependency>
      <dependency>
        <groupId>io.swagger.core.v3</groupId>
        <artifactId>swagger-annotations-jakarta</artifactId>
        <version>2.2.30</version>
      </dependency>
      <!-- Note: aipersimmon-ddd-quality-config (the shared PMD/SpotBugs rulesets) is
           deliberately NOT listed here — it is a plugin-classpath artifact, never a normal
           dependency, so a BOM entry would wrongly imply it is consumable. -->
      <!-- In-memory fakes for the framework's ports plus the @WithTenant JUnit extension;
           consumers add it at test scope. -->
      <dependency>
        <groupId>com.aipersimmon.ddd</groupId>
        <artifactId>aipersimmon-ddd-test</artifactId>
        <version>${project.version}</version>
      </dependency>
      <!-- Reusable Testcontainers support (singleton containers + Spring Boot
           @ServiceConnection configs); consumers add it at test scope. -->
      <dependency>
        <groupId>com.aipersimmon.ddd</groupId>
        <artifactId>aipersimmon-ddd-test-support</artifactId>
        <version>${project.version}</version>
