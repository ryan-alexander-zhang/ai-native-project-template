<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.aipersimmon.ddd</groupId>
    <artifactId>aipersimmon-ddd-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <!--
    The storage-agnostic engine of the durable Process Manager: the reusable runtime, query,
    operations, effect relay, deadline worker, dispatchers, retry, serdes, backlog, and
    observability — everything that is NOT tied to a particular database. It runs against four store
    ports (ProcessInstanceStore / ProcessTransitionStore / ProcessEffectStore / ProcessDeadlineStore),
    one ProcessClaimStrategy, and a ProcessUnitOfWork; a storage backend
    (aipersimmon-ddd-process-manager-jdbc, aipersimmon-ddd-process-manager-mybatis-plus) supplies the
    adapters. Because the engine lives here once, both backends run identical logic — only the SQL
    access differs.

    It carries the shared Spring auto-configuration, validated properties, the worker-scheduling
    lifecycle, the observability seams, the optional Jackson codec convenience layer, and the
    four-table reference migration SQL. It depends on Spring tx / context / boot-autoconfigure (a
    durable runtime needs a transaction boundary and an auto-config seam) but NOT on spring-jdbc or
    any ORM. The orchestration classes themselves are framework-free by construction: they touch only
    the ports. Include exactly one storage backend starter; a broker starter plugs into either.
  -->
  <artifactId>aipersimmon-ddd-process-manager-engine</artifactId>
  <name>aipersimmon-ddd-process-manager-engine</name>
  <description>Storage-agnostic engine of the durable Process Manager: runtime, relay, deadline worker, and shared Spring wiring over store ports.</description>

  <dependencies>
    <!-- The UUIDv7 IdGenerator implementation, at runtime scope: this module compiles against the
         IdGenerator SPI in aipersimmon-ddd-core and never names anything in this starter, but the
         bean has to exist or the framework mints ids with UUID.randomUUID() and reintroduces the
         random-key write amplification the SPI was added to remove — with no startup signal (see
         issue-00053). Runtime scope says exactly that and still reaches the application's
         classpath transitively; compile scope claimed a code dependency that was never there. -->
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-id-spring-boot-starter</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-process-manager</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Observability SPI (framework-free, no-op by default): the runtime opens a process.advance
         span through it, so relay/deadline-driven advances are visible. -->
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-observability</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- IntegrationEvents: the integration-event effect dispatcher publishes through it. -->
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-application</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The unit-of-work is a Spring TransactionTemplate; the engine composes its REQUIRED
         transaction with an existing Inbox and command-handler transaction. No spring-jdbc here. -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-tx</artifactId>
    </dependency>
    <!-- Auto-configuration seam + the SmartLifecycle worker scheduler. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

    <!-- Observability seams are optional: metrics bind only when Micrometer is present, the health
         indicator only when Actuator is present, and the Jackson codec layer only when Jackson is. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-core</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-actuator</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!--
    A coverage gate on the parts that have one, and an honest boundary around the parts that do
    not. This module holds the framework's most consequential decisions and had no tests at all,
    while the pure value-type modules had a 90% gate — the gates sat where the risk was not.

    What is gated: everything that decides something — the advance and its write side, the effect
    relay, the deadline worker, the parked-input drain, the operator facade, the retry schedule,
    the backlog reads, and the persisted conventions. The four store ports have in-memory
    implementations under src/test/java/.../engine/store that keep the refusals the engine's
    guarantees are built on (lease fencing, the revision guard, the (instance, input) dedup key),
    so these are tests of the engine's decisions rather than of stubs that always say yes.

    One class inside `runtime` is excluded by name: SpringTxProcessUnitOfWork is six lines
    delegating to Spring's TransactionTemplate, and a test over a mock PlatformTransactionManager
    would assert the mock rather than the propagation Spring performs. Its behaviour is covered
    where it is real — the scaffold's end-to-end tests against PostgreSQL and MySQL.

    What is NOT gated, deliberately and not silently: `autoconfigure`. It is Spring wiring, whose
    one meaningful test is that a context actually starts, and both storage backends already
    start one against a real database; rebuilding that here — in a module that deliberately
    carries no Spring context — would only re-prove what they prove. Naming it is better than a
    whole-module threshold set low enough to pass, which would read as coverage rather than as a
    gap.
  -->
  <build>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>jacoco-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <includes>
                <include>com/aipersimmon/ddd/processmanager/engine/retry/**</include>
                <include>com/aipersimmon/ddd/processmanager/engine/observe/**</include>
                <include>com/aipersimmon/ddd/processmanager/engine/relay/**</include>
                <include>com/aipersimmon/ddd/processmanager/engine/deadline/**</include>
                <include>com/aipersimmon/ddd/processmanager/engine/runtime/**</include>
                <include>com/aipersimmon/ddd/processmanager/engine/replay/**</include>
                <include>com/aipersimmon/ddd/processmanager/engine/operation/**</include>
                <include>com/aipersimmon/ddd/processmanager/engine/store/ParkedInputs*</include>
                <include>com/aipersimmon/ddd/processmanager/engine/store/Payloads*</include>
              </includes>
              <excludes>
                <exclude>
                  com/aipersimmon/ddd/processmanager/engine/runtime/SpringTxProcessUnitOfWork*
                </exclude>
              </excludes>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.90</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.80</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
