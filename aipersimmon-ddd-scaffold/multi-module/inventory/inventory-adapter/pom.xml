<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.example</groupId>
    <artifactId>multi-module</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <!--
    Interface layer of the inventory context. Its inbound adapter reacts to the
    ordering context's published event and drives the reserve-stock use case.
  -->
  <artifactId>inventory-adapter</artifactId>
  <name>inventory-adapter</name>
  <description>Inbound messaging adapter of the inventory context.</description>

  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>inventory-application</artifactId>
    </dependency>
    <!-- This context's own published contract: the ipc adapter implements the
         StockAvailabilityApi Open Host Service defined here. -->
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>inventory-api</artifactId>
    </dependency>
    <!-- Sends the ReserveStock command through the command bus. -->
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-cqrs</artifactId>
    </dependency>
    <!-- Inbound ACL: InboundEvents.commandContext turns the received EventEnvelope's
         identity into the triggered command's cause, so the causal chain survives the hop. -->
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-application</artifactId>
    </dependency>
    <!-- EventEnvelope: the wire form these listeners receive. -->
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-integration</artifactId>
    </dependency>
    <!-- Cross-context: consumes ordering's published contract. -->
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>ordering-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context</artifactId>
    </dependency>
    <!-- OrderReadyForFulfilmentVersionsTest: proves both revisions of ordering's contract translate
         to the same command. No Spring context — the translation is the unit under test, and the
         retired v1 path is exercised by nothing else, since an end-to-end test only ever sees the
         revision the producer currently publishes. -->
    <!-- The framework port fakes (RecordingCommandBus / RecordingIntegrationEvents), maintained
         by the framework so their identity semantics match the real implementations. -->
    <!-- Test only: StockAvailabilityServiceTest assembles the real query handler over the real
         RegistryQueryBus, so the verdict arithmetic is tested through the same dispatch the
         application uses. -->
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-cqrs-spring-boot-starter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
