<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.example</groupId>
    <artifactId>multi-module</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <!-- Infrastructure layer of the inventory context: the Stock and Reservation aggregate
       repositories. The storage each one speaks is stated on the implementing class. -->
  <artifactId>inventory-infrastructure</artifactId>
  <name>inventory-infrastructure</name>
  <description>Technical port implementations of the inventory context.</description>

  <dependencies>
    <!-- Version-checked aggregate repository base + the optimistic-locker InnerInterceptor
         contribution. -->
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-persistence-mybatis-plus</artifactId>
    </dependency>
    <!-- DomainEvents: the repository drains the aggregate's recorded events as part of save,
         inside the command transaction, so no handler has to remember a second call. -->
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-application</artifactId>
    </dependency>
    <!-- org.springframework.dao.OptimisticLockingFailureException: the repository raises it when a
         version-checked update matches no row, and the framework's ConcurrencyTranslationCommandInterceptor
         turns it into ConcurrencyConflictException -> HTTP 409. -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-tx</artifactId>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>inventory-domain</artifactId>
    </dependency>
    <!--
      inventory-application, for the StockQueries read port this module now implements. The other
      adapters here implement domain repository ports, so inventory-domain was enough; a READ port
      belongs to the application layer (the aggregate boundary governs writes, not reads), which is
      why answering it needs this dependency. Same shape as ordering-infrastructure implementing
      OrderQueries.
    -->
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>inventory-application</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context</artifactId>
    </dependency>
    <!-- MyBatis-Plus for the JDBC persistence adapters (BaseMapper, wrappers, @TableName). No
         <version> here: the reactor root imports mybatis-plus-bom, which manages it. -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-core</artifactId>
    </dependency>

    <!-- Unit tests for the read adapter's own logic (filling in SKUs the IN clause did not find);
         the SQL itself is covered end to end by every placement in `start`. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
