<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.example</groupId>
    <artifactId>multi-module</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <!--
    The infrastructure layer: technical implementations of the domain and
    application ports — the aggregate repositories, the read-side query port, and
    the outbound gateway to another context. Which storage or protocol each one
    speaks is stated on the implementing class, not here; this module's contract is
    only that replacing an implementation leaves the domain and application untouched.
  -->
  <artifactId>ordering-infrastructure</artifactId>
  <name>ordering-infrastructure</name>
  <description>Technical port implementations of the ordering context.</description>

  <dependencies>
    <!-- Version-checked aggregate repository base + the optimistic-locker InnerInterceptor
         contribution. -->
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-persistence-mybatis-plus</artifactId>
    </dependency>
    <!-- org.springframework.dao.OptimisticLockingFailureException: the repository raises it when a
         version-checked update matches no row, and the framework's ConcurrencyTranslationCommandInterceptor
         turns it into ConcurrencyConflictException -> HTTP 409. -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-tx</artifactId>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>ordering-domain</artifactId>
    </dependency>
    <!-- The gateway adapter fulfils an application-layer gateway port over another context's api. -->
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>ordering-application</artifactId>
    </dependency>
    <!-- Cross-context (anti-corruption gateway): calls the inventory context only
         through its published api. The concrete StockAvailabilityApi bean (in-process
         now, an HTTP client once inventory is its own service) is wired at runtime. -->
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>inventory-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context</artifactId>
    </dependency>
    <!-- MyBatis-Plus for the JDBC persistence adapters (BaseMapper, wrappers, @TableName). No
         <version> here: the reactor root imports mybatis-plus-bom, which manages it. A literal
         version would override the BOM silently and let this module compile against a different
         line from `start`. -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-core</artifactId>
    </dependency>
  </dependencies>
</project>
