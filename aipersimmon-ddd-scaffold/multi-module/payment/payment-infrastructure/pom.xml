<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.example</groupId>
    <artifactId>multi-module</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <!--
    Infrastructure layer of the payment context: the outbound adapter that implements the
    PaymentOperations port. This context owns no persisted aggregate, so its only technical concern
    is the at-most-once operation-dedupe log, kept in memory here (the lightest honest stand-in for a
    durable operations table). Even in-memory it is an outbound adapter, so it lives here, not in the
    application layer.
  -->
  <artifactId>payment-infrastructure</artifactId>
  <name>payment-infrastructure</name>
  <description>Technical port implementations of the payment context (in-memory operation log).</description>

  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>payment-application</artifactId>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>payment-domain</artifactId>
    </dependency>
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context</artifactId>
    </dependency>
    <!--
      MyBatis, for the payment_operations table. This context still owns no persisted aggregate —
      the table is a business-idempotency log, a technical outbound adapter — but the log has to be
      written through the *caller's* transaction, on the same DataSource as the outbox. That
      co-transactionality, not durability, is what makes the at-most-once authorization pattern
      correct, and it is why a ConcurrentHashMap could not stand in for it.

      A plain @Mapper with two statements, not the MybatisPlusAggregateRepository the other two
      contexts use: there is no aggregate here, no identity to load and no version to check.
    -->
    <!-- No <version>: the reactor root imports mybatis-plus-bom, which manages it. Same
         dependency the other two infrastructure modules take; it carries the org.apache.ibatis
         annotations this mapper uses. -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-tenancy</artifactId>
    </dependency>
    <!-- The retention job says how many rows it dropped. A scheduled task that deletes data and
         reports nothing is the kind of thing that is only ever noticed when it has been broken for
         a month. Version managed by the Spring Boot BOM. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <!-- Unit test for the retention cutoff: a stub mapper, no database. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
