<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.example</groupId>
    <artifactId>multi-module</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <!--
    The bootstrap module: the Spring Boot application that assembles every layer
    into one deployable, and the home of the architecture tests that verify the
    whole context (layering rules via bytecode, package-info presence via source).
  -->
  <artifactId>start</artifactId>
  <name>start</name>
  <description>Spring Boot bootstrap and architecture tests for the ordering context.</description>

  <dependencies>
    <dependency><groupId>${project.groupId}</groupId><artifactId>ordering-api</artifactId></dependency>
    <dependency><groupId>${project.groupId}</groupId><artifactId>ordering-domain</artifactId></dependency>
    <dependency><groupId>${project.groupId}</groupId><artifactId>ordering-application</artifactId></dependency>
    <dependency><groupId>${project.groupId}</groupId><artifactId>ordering-infrastructure</artifactId></dependency>
    <dependency><groupId>${project.groupId}</groupId><artifactId>ordering-adapter</artifactId></dependency>
    <dependency><groupId>${project.groupId}</groupId><artifactId>ordering-process-mybatis-plus</artifactId></dependency>

    <dependency><groupId>${project.groupId}</groupId><artifactId>inventory-api</artifactId></dependency>
    <dependency><groupId>${project.groupId}</groupId><artifactId>inventory-domain</artifactId></dependency>
    <dependency><groupId>${project.groupId}</groupId><artifactId>inventory-application</artifactId></dependency>
    <dependency><groupId>${project.groupId}</groupId><artifactId>inventory-infrastructure</artifactId></dependency>
    <dependency><groupId>${project.groupId}</groupId><artifactId>inventory-adapter</artifactId></dependency>

    <dependency><groupId>${project.groupId}</groupId><artifactId>payment-api</artifactId></dependency>
    <dependency><groupId>${project.groupId}</groupId><artifactId>payment-domain</artifactId></dependency>
    <dependency><groupId>${project.groupId}</groupId><artifactId>payment-application</artifactId></dependency>
    <dependency><groupId>${project.groupId}</groupId><artifactId>payment-infrastructure</artifactId></dependency>
    <dependency><groupId>${project.groupId}</groupId><artifactId>payment-adapter</artifactId></dependency>

    <!--
      The whole aipersimmon-ddd MyBatis-Plus stack in one dependency: CQRS buses, in-process events,
      time-ordered UUIDv7 ids, the RFC 9457 web contract, versioned aggregate repositories, the
      transactional outbox, the consumer inbox, the durable process manager, the operation log,
      multi-tenancy, and the Flyway schema applier.

      Bundling is not enabling. Tenancy stays inert until aipersimmon.ddd.tenancy.enabled=true and
      Flyway applies only the components listed under aipersimmon.ddd.flyway.components (both in
      application.yml), so nothing here starts writing tables on its own.

      Everything inside remains individually available: a project that wants, say, CQRS and the
      outbox but not the process manager declares those two modules instead. The bundle is the
      default path, not the only one.
    -->
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-starter-mybatis-plus</artifactId>
    </dependency>
    <!--
      Cross-service integration events over Kafka (decision-00006 "方式三": broker + outbox). It is
      built ON the outbox the bundle above provides, not instead of it: only @Externalized events
      cross the broker, the ShedLock-guarded relay publishes them as CloudEvents, and the
      inbox-guarded consumer bridge republishes them in process so the existing @EventListener
      handlers are untouched. consumer.enabled=true is what registers that bridge.
    -->
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-starter-messaging-kafka</artifactId>
    </dependency>
    <!--
      Two deliberately un-bundled add-ons. Both pull an opinionated third-party stack, so they stay
      an explicit choice rather than something the default path decides for you:

        - openapi: springdoc (the /v3/api-docs scanner + Swagger UI) plus a customizer that
          documents the RFC 9457 problem responses the web layer emits.
        - observability-otel: the OpenTelemetry Spring Boot starter (boundary auto-instrumentation
          for HTTP/JDBC/Kafka, logback-MDC and Micrometer exemplar bridges), exporting over OTLP.
          The framework-free observability SPIs are already present and no-op without this; adding
          it binds them to OpenTelemetry.
    -->
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-openapi-spring-boot-starter</artifactId>
    </dependency>
    <!--
      Shared storage for the HTTP edge's stateful protections — here, the idempotency store behind
      POST /orders (aipersimmon.ddd.web.idempotency in application.yml). Without it those
      protections fall back to per-JVM maps, which stop protecting anything the moment a second
      instance exists; allow-in-memory-stores=false turns that fallback into a startup failure
      rather than a silent weakening.

      Note the suffix: -web-store-jdbc, in an application whose other tables are MyBatis-Plus. The
      framework's edge stores speak plain JdbcTemplate on the same DataSource, and there is no
      -mybatis-plus variant, so a MyBatis-Plus application still declares this one. It shares the
      transaction and the connection pool, so nothing else changes.
    -->
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-web-store-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-observability-otel-spring-boot-starter</artifactId>
    </dependency>

    <!-- Flyway 10+ ships PostgreSQL support as a separate module (this app runs on PostgreSQL). -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <!-- MyBatis-Plus: provides the SqlSessionFactory the outbox/inbox variants and the aggregate
         mappers share. Version comes from the mybatis-plus-bom imported by the reactor root. -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
    </dependency>

    <!--
      SQL-parsing inner interceptors + jsqlparser. Since MyBatis-Plus 3.5.9 the interceptors that
      rewrite SQL (TenantLineInnerInterceptor, PaginationInnerInterceptor, …) and their jsqlparser
      dependency live in this module, split out of the starter so jsqlparser stays optional. The
      tenant-line interceptor below needs it, so the consuming app opts in explicitly. Version comes
      from the mybatis-plus-bom.
    -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-jsqlparser</artifactId>
    </dependency>

    <!-- PostgreSQL for the four process tables; started from compose.yaml by spring-boot-docker-compose. -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-docker-compose</artifactId>
      <scope>runtime</scope>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <!--
      Actuator: health / liveness / readiness probes (and the info/metrics endpoints). Without it
      /actuator/** is unmapped, so a probe request falls through to the no-handler path — which the
      web advice now renders as a proper 404 rather than a 500 (issue-00045), but a deployment still
      needs the real health endpoint for orchestration readiness/liveness checks.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!--
      Bean Validation provider (Hibernate Validator). Bringing it onto the classpath
      is what activates the command bus's ValidationCommandInterceptor (auto-wired
      only when a provider is present) and makes @Valid on inbound DTOs effective.
      Without it, JSR 380 annotations on commands are silently inert.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-archunit</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      The acceptance tests run against real middleware — PostgreSQL and a Kafka broker — and this one
      dependency supplies both: @ServiceConnection configs (imported by TestInfrastructure) pinned to
      the image versions the library itself tests against, plus Testcontainers and
      spring-boot-testcontainers transitively. Nothing here names a container image or a
      Testcontainers artifact, so the sample cannot drift from the library's versions.
    -->
    <dependency>
      <groupId>com.aipersimmon.ddd</groupId>
      <artifactId>aipersimmon-ddd-test-support</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
