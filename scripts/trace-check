#!/usr/bin/env python3
"""Docs<->code traceability gate. See decision-00001-trace-ids-and-trace-check.

Checks, over every tracked file of the repo the cwd is in:
  a. doc ids well-formed and unique; type/folder match the id
  b. relation fields legal for the type (matrix read from whiteboard.config.yaml),
     every listed id resolves to an existing doc or requirement item
  c. every FR/BR of an active spec/rule has at least one AC
  d. every AC in a plan's delivery scope is carried by a test name suffix
     (`__spec_00001_AC_5_1`) — UNCOVERED fails a resolved plan, reports an open one
  e. every row of an active record names an existing id and a test that exists
     and carries that id
  f. every AC suffix found in code resolves to an existing AC — ORPHANED fails;
     an AC outside every plan's scope is reported
  g. a resolved plan has a passing record row for every AC in its scope
  h. a record row whose Evidence carries `ac:<hash>` is SUSPECT when the AC (or
     its FR line) changed since — `scripts/trace-check --hash <ac-id>...` prints hashes
  i. the relation matrix is read from each docs/<type>/README.md Relations section;
     whiteboard.config.yaml `carries:` must agree with it
  j. every `Enforced by` path in ARCHITECTURE.md's Boundaries table is a tracked file;
     `Unenforced: <why>` rows are counted, empty cells fail
  k. an active spec/rule/design/decision is STALE when more than 10 commits since its
     `verified_against` touched its related code (carrying-test files, design `anchor:`
     paths, a decision's constrains); reported — fails only a resolved plan that implements it
  l. an active doc citing an active decision that neither constrains it nor is implemented
     by it is UNBOUND (reported)
Exit 1 on any ERROR line; stdlib only.

`trace-check --impact <git range>` is read-only and always exits 0: for every non-Markdown
file the range changed it lists the carried ACs of tests in that file, the tests that import
it, the designs whose `anchor:` covers it, and the spec/rule docs those ACs belong to.
"""
import hashlib
import pathlib
import re
import subprocess
import sys

TYPES = "analysis|decision|design|idea|integration|issue|operation|plan|prd|prompt|record|reference|report|rule|spec|task"
LIVING = {"draft", "active", "archived"}
WORK = {"draft", "open", "resolved", "wontfix", "archived"}
WORK_TYPES = {"issue", "plan", "task"}
DOC_ID = re.compile(rf"^({TYPES})-\d{{5}}-[a-z0-9][a-z0-9-]*$")
ITEM_ID = re.compile(r"^((?:spec|rule)-\d{5})-(FR|BR|AC)-(\d+)(?:\.(\d+))?$")
DECL = re.compile(r"^(?:- |\| )\*\*((?:spec|rule)-\d{5}-(?:FR|BR)-\d+)\*\*")
AC_DECL = re.compile(r"^- \*\*((?:spec|rule)-\d{5}-AC-\d+\.\d+)\*\* \(((?:spec|rule)-\d{5}-(?:FR|BR)-\d+)\)")
SUFFIX = re.compile(r"__((?:spec|rule)_\d{5}_AC_\d+_\d+)\b")
NON_RELATION = {"id", "type", "status", "decided_by", "verified_against"}
ANCHOR = re.compile(r"^anchor:\s*(\S+)\s*$", re.M)
DEC_ID = re.compile(r"\bdecision-\d{5}-[a-z0-9][a-z0-9-]*")
FRESH_TYPES = {"spec", "rule", "design", "decision"}
STALE_AFTER = 10  # commits touching related code; decision-00003
ITEM_FIELDS = {("plan", "implements"), ("record", "verifies")}
SKIP_FILES = {"scripts/trace-check", ".trace-check-allow"}


def suffix_of(ac_id):
    return ac_id.replace("-", "_").replace(".", "_")


def id_of_suffix(s):
    t, n, _, i, k = s.split("_")
    return f"{t}-{n}-AC-{i}.{k}"


def front_matter(text):
    if not text.startswith("---\n"):
        return None
    end = text.find("\n---", 4)
    if end < 0:
        return None
    fm = {}
    for line in text[4:end].splitlines():
        line = line.split("#", 1)[0].rstrip()
        if ":" not in line:
            continue
        k, v = line.split(":", 1)
        v = v.strip()
        if v.startswith("[") and v.endswith("]"):
            v = [x.strip() for x in v[1:-1].split(",") if x.strip()]
        fm[k.strip()] = v
    return fm, text[end + 4:]


def readme_matrix(root):
    """type -> relation fields, from the field bullets of each README Relations section."""
    out = {}
    for p in sorted((root / "docs").glob("*/README.md")):
        fields, on = [], False
        for line in p.read_text(encoding="utf-8").splitlines():
            if line.startswith("## "):
                on = line.strip() == "## Relations"
            elif on and (m := re.match(r"^- `([a-z_]+)`", line)):
                fields.append(m.group(1))
        out[p.parent.name] = fields
    return out


def yaml_matrix(root):
    p = root / "whiteboard.config.yaml"
    if not p.exists():
        return None
    m = re.search(r"^carries:\n((?:[ \t]+\S.*\n)+)", p.read_text(encoding="utf-8"), re.M)
    if not m:
        return None
    out = {}
    for line in m.group(1).splitlines():
        k, v = line.strip().split(":", 1)
        out[k] = [x.strip() for x in v.strip()[1:-1].split(",") if x.strip()]
    return out


def ac_hash(text):
    return hashlib.sha1(" ".join(text.split()).encode()).hexdigest()[:8]


def checklist_rows(body):
    rows, header = [], None
    for line in body.splitlines():
        if not line.startswith("|"):
            header = None
            continue
        cells = [c.strip() for c in line.strip().strip("|").split("|")]
        if header is None:
            low = [c.lower() for c in cells]
            ti = next((i for i, c in enumerate(low) if "test" in c or "测试" in c), None)
            ri = next((i for i, c in enumerate(low) if "result" in c or "结果" in c), None)
            ei = next((i for i, c in enumerate(low) if "evidence" in c or "证据" in c), None)
            if ti and ri:
                header = (ti, ri, ei)
            continue
        if cells and ITEM_ID.match(cells[0]) and len(cells) > max(header[:2]):
            ev = cells[header[2]] if header[2] is not None and len(cells) > header[2] else ""
            rows.append((cells[0], cells[header[0]], cells[header[1]].lower(), ev))
    return rows


def boundary_rows(text):
    """(rule, enforced_by) rows of the `| Rule | Enforced by |` table in ARCHITECTURE.md."""
    rows, on = [], False
    for line in text.splitlines():
        if not line.startswith("|"):
            on = False
            continue
        cells = [c.strip() for c in line.strip().strip("|").split("|")]
        low = [c.lower() for c in cells]
        if not on:
            on = len(cells) >= 2 and low[0] == "rule" and low[1] == "enforced by"
            continue
        if set("".join(cells)) <= set("-: "):
            continue
        rows.append((cells[0], cells[1] if len(cells) > 1 else ""))
    return rows


def test_name(cell):
    name = cell.strip("`").split("::")[-1].split(" (")[0].strip()
    return name.split("/")[-1]


IMPORT_LINE = re.compile(r"^\s*(?:import|from|require|use|using|#include)\b|require\(|import\(", re.M)


def import_refs(text, path):
    """True when an import/require line in `text` names `path` (same-repo relative form)."""
    stem = re.sub(r"\.[^./]+$", "", path)
    needles = {stem, stem.replace("/", "."), "./" + stem, stem.split("/")[-1]}
    for line in text.splitlines():
        if IMPORT_LINE.match(line) or "require(" in line or "import(" in line:
            for n in needles:
                if re.search(r"(?<![\w])" + re.escape(n) + r"(?![\w])", line):
                    return True
    return False


def impact(root, rng, files, docs, by_prefix, carried, texts):
    changed = [f for f in subprocess.check_output(["git", "diff", "--name-only", rng, "--"], cwd=root, text=True).split("\n") if f and not f.endswith(".md")]
    by_file = {}
    for sfx, where in carried.items():
        for f in where:
            by_file.setdefault(f, set()).add(id_of_suffix(sfx))
    designs = [d for d in docs.values() if d["type"] == "design" and d["fm"].get("status") == "active"]
    hit = False
    for f in changed:
        acs = set(by_file.get(f, ()))
        importers = [t for t in texts if t != f and t in by_file and import_refs(texts[t], f)]
        for t in importers:
            acs |= by_file[t]
        anchored = [(d, a) for d in designs for a in ANCHOR.findall(d["body"]) if f == a.rstrip("/") or f.startswith(a.rstrip("/") + "/")]
        if not acs and not anchored:
            continue
        hit = True
        print(f"IMPACT {f}")
        if f in by_file:
            print(f"  tests:   {f} carries {len(by_file[f])} AC(s)")
        for t in importers:
            print(f"  imports: {t} carries {len(by_file[t])} AC(s)")
        for ac in sorted(acs):
            m = ITEM_ID.match(ac)
            doc = by_prefix.get(m.group(1))
            item = doc["acs"].get(ac) if doc else None
            print(f"  AC:      {ac} ({item or 'unknown item'})")
        for doc in sorted({by_prefix[ITEM_ID.match(ac).group(1)]["path"] for ac in acs if ITEM_ID.match(ac).group(1) in by_prefix}):
            print(f"  doc:     {doc}")
        for d, a in anchored:
            print(f"  design:  {d['path']} (anchor {a})")
    if not hit:
        print("IMPACT none: no carried test or design anchor touches this diff")
    return 0


def main(root, hash_ids=(), impact_range=None):
    errors, notes = [], []
    err = errors.append
    files = [f for f in subprocess.check_output(["git", "ls-files", "-z"], cwd=root, text=True).split("\0") if f]
    docs, by_prefix = {}, {}

    # a. ids, types, folders, status vocabulary
    for f in files:
        if not (f.startswith("docs/") and f.endswith(".md")) or pathlib.Path(f).name in ("README.md", "TEMPLATE.md"):
            continue
        parsed = front_matter((root / f).read_text(encoding="utf-8"))
        if not parsed:
            err(f"{f}: missing front matter")
            continue
        fm, body = parsed
        did = fm.get("id")
        if not isinstance(did, str) or not DOC_ID.match(did):
            err(f"{f}: bad or missing id {did!r}")
            continue
        t = did.split("-")[0]
        prefix = did[: len(t) + 6]
        if did in docs:
            err(f"{f}: duplicate id {did} (also {docs[did]['path']})")
            continue
        if prefix in by_prefix:
            err(f"{f}: number {prefix} already used by {by_prefix[prefix]['path']}")
        if fm.get("type") != t:
            err(f"{f}: type {fm.get('type')!r} does not match id prefix {t!r}")
        if not f.startswith(f"docs/{t}/"):
            err(f"{f}: a {t} doc must live under docs/{t}/")
        vocab = WORK if t in WORK_TYPES else LIVING
        if fm.get("status") not in vocab:
            err(f"{f}: status {fm.get('status')!r} not in {sorted(vocab)}")
        d = dict(path=f, fm=fm, body=body, type=t, prefix=prefix, id=did, items={}, acs={}, text={})
        docs[did] = d
        by_prefix.setdefault(prefix, d)

    # items and ACs of spec/rule docs
    for d in docs.values():
        if d["type"] not in ("spec", "rule"):
            continue
        pending, cur = [], None
        for line in d["body"].splitlines():
            m = DECL.match(line)
            if m and m.group(1).startswith(d["prefix"] + "-"):
                if m.group(1) in d["items"]:
                    err(f"{d['path']}: {m.group(1)} declared twice")
                d["items"].setdefault(m.group(1), set())
                d["text"][m.group(1)] = line
                cur = None
                continue
            m = AC_DECL.match(line)
            if m and m.group(1).startswith(d["prefix"] + "-"):
                pending.append(m.groups())
                cur = m.group(1)
                d["text"][cur] = line
            elif cur and line[:1].isspace() and line.strip():
                d["text"][cur] += "\n" + line  # Given / When / Then continuation
            else:
                cur = None
        for ac, parent in pending:
            if ac in d["acs"]:
                err(f"{d['path']}: {ac} declared twice")
            elif parent not in d["items"]:
                err(f"{d['path']}: {ac} attributed to undeclared {parent}")
            else:
                d["acs"][ac] = parent
                d["items"][parent].add(ac)
                d["text"][ac] = d["text"][parent] + "\n" + d["text"][ac]
        # c. unverified items
        if d["fm"].get("status") == "active":
            for item, acs in d["items"].items():
                if not acs:
                    err(f"{d['path']}: {item} has no acceptance (unverified)")

    def item_exists(iid):
        m = ITEM_ID.match(iid)
        doc = by_prefix.get(m.group(1)) if m else None
        if not doc:
            return False
        return iid in (doc["acs"] if m.group(2) == "AC" else doc["items"])

    def hash_of(ac):
        return ac_hash(by_prefix[ITEM_ID.match(ac).group(1)]["text"][ac])

    if impact_range:
        # texts/carried are built below; jump ahead by building them here
        texts, carried = {}, {}
        for f in files:
            if f.endswith(".md") or f in SKIP_FILES:
                continue
            try:
                texts[f] = (root / f).read_text(encoding="utf-8", errors="ignore")
            except OSError:
                continue
            for s in SUFFIX.findall(texts[f]):
                carried.setdefault(s, set()).add(f)
        return impact(root, impact_range, files, docs, by_prefix, carried, texts)

    if hash_ids:
        for i in hash_ids:
            print(i, f"ac:{hash_of(i)}" if item_exists(i) and ITEM_ID.match(i).group(2) == "AC" else "no such AC")
        return 0

    # b. + i. relation fields; matrix from READMEs, yaml must agree
    matrix = readme_matrix(root)
    ymatrix = yaml_matrix(root)
    for t, fields in (ymatrix or {}).items():
        if t in matrix and set(fields) != set(matrix[t]):
            err(f"whiteboard.config.yaml carries: {t}: {fields} != docs/{t}/README.md Relations {matrix[t]}")
    for d in docs.values():
        for k, v in d["fm"].items():
            if k == "decided_by" and d["type"] != "decision":
                err(f"{d['path']}: decided_by is decision-only")
            if k in NON_RELATION:
                continue
            if matrix is not None and d["type"] in matrix and k not in set(matrix[d["type"]]) | {"supersedes"}:
                err(f"{d['path']}: field {k} is not carried by type {d['type']}")
            if k == "parent" and isinstance(v, list):
                err(f"{d['path']}: parent is single-valued")
            ids = v if isinstance(v, list) else [v]
            if not ids or ids == [""]:
                err(f"{d['path']}: empty field {k} must be omitted")
                continue
            for i in ids:
                if DOC_ID.match(i):
                    if i not in docs:
                        err(f"{d['path']}: {k} names missing doc {i}")
                elif ITEM_ID.match(i):
                    if (d["type"], k) not in ITEM_FIELDS:
                        err(f"{d['path']}: item id {i} not allowed in {k}")
                    elif not item_exists(i):
                        err(f"{d['path']}: {k} names missing item {i}")
                else:
                    err(f"{d['path']}: {k} has malformed id {i!r}")

    # tests carrying AC ids
    texts, carried = {}, {}
    for f in files:
        if f.endswith(".md") or f in SKIP_FILES:
            continue
        try:
            texts[f] = (root / f).read_text(encoding="utf-8", errors="ignore")
        except OSError:
            continue
        for s in SUFFIX.findall(texts[f]):
            carried.setdefault(s, set()).add(f)

    def scope_acs(plan):
        acs = set()
        for i in plan["fm"].get("implements", []):
            if DOC_ID.match(i):
                d = docs.get(i)
                if d and d["type"] in ("spec", "rule"):
                    for item_acs in d["items"].values():
                        acs |= item_acs
                continue
            m = ITEM_ID.match(i)
            doc = by_prefix.get(m.group(1)) if m else None
            if not doc or not item_exists(i):
                continue
            item = doc["acs"][i] if m.group(2) == "AC" else i
            acs |= doc["items"][item]
        return acs

    # k. freshness
    def tracked_under(p):
        p = p.rstrip("/")
        return any(f == p or f.startswith(p + "/") for f in files)

    def related_paths(d, seen=()):
        if d["type"] in ("spec", "rule"):
            return {f for ac in d["acs"] for f in carried.get(suffix_of(ac), ())}
        if d["type"] == "design":
            return {a for a in ANCHOR.findall(d["body"]) if tracked_under(a)}
        if d["type"] == "decision":
            out, seen = set(), seen + (d["id"],)
            bound = set(d["fm"].get("constrains", [])) | {o["id"] for o in docs.values() if d["id"] in o["fm"].get("implements", [])}
            for cid in bound:
                c = docs.get(cid)
                if c and c["type"] in FRESH_TYPES and cid not in seen:
                    out |= related_paths(c, seen)
            return out
        return set()

    def commits_since(sha, paths):
        ok = subprocess.run(["git", "cat-file", "-e", f"{sha}^{{commit}}"], cwd=root, capture_output=True)
        if ok.returncode:
            return None
        out = subprocess.check_output(["git", "rev-list", "--count", f"{sha}..HEAD", "--", *sorted(paths)], cwd=root, text=True)
        return int(out.strip())

    for d in docs.values():
        if d["type"] == "design":
            for a in ANCHOR.findall(d["body"]):
                if not tracked_under(a):
                    err(f"{d['path']}: anchor {a} is not a tracked path")

    stale = set()
    for d in docs.values():
        if d["type"] not in FRESH_TYPES or d["fm"].get("status") != "active":
            continue
        va = d["fm"].get("verified_against")
        if not va:
            notes.append(f"UNVERIFIED-AGE {d['path']}: no verified_against")
            continue
        if not isinstance(va, str) or not re.fullmatch(r"[0-9a-f]{7,40}", va):
            err(f"{d['path']}: verified_against {va!r} is not a commit hash")
            continue
        paths = related_paths(d)
        if not paths:
            continue
        n = commits_since(va, paths)
        if n is None:
            notes.append(f"NOTE {d['path']}: verified_against {va} is not in this history (shallow clone?)")
        elif n > STALE_AFTER:
            stale.add(d["id"])
            notes.append(f"STALE {d['path']}: verified_against {va}, {n} commits since touched {', '.join(sorted(paths))}")

    # l. unbound decision citations
    for d in docs.values():
        if d["type"] not in ("spec", "rule", "design", "plan") or d["fm"].get("status") not in ("active", "open", "resolved"):
            continue
        cited = set(DEC_ID.findall(d["body"]))
        for v in d["fm"].values():
            for i in (v if isinstance(v, list) else [v]):
                if isinstance(i, str) and DEC_ID.fullmatch(i):
                    cited.add(i)
        for cid in sorted(cited):
            c = docs.get(cid)
            if not c or c["fm"].get("status") != "active":
                continue
            if d["id"] in c["fm"].get("constrains", []) or cid in d["fm"].get("implements", []):
                continue
            notes.append(f"UNBOUND {d['path']}: cites {cid}, which neither constrains it nor is implemented by it")

    allow_path = root / ".trace-check-allow"
    allowed = set(allow_path.read_text().split()) if allow_path.exists() else set()
    for p in sorted(allowed):
        notes.append(f"NOTE {p} is in .trace-check-allow: UNCOVERED reported, not failed")

    # e. record rows; passing rows per plan
    passing = {}
    for d in docs.values():
        if d["type"] != "record" or d["fm"].get("status") != "active":
            continue
        rows = checklist_rows(d["body"])
        unhashed = 0
        for iid, tcell, result, ev in rows:
            if not item_exists(iid):
                err(f"{d['path']}: row names missing item {iid}")
                continue
            m = ITEM_ID.match(iid)
            doc = by_prefix[m.group(1)]
            acs = {iid} if m.group(2) == "AC" else doc["items"][iid]
            name = test_name(tcell)
            if not any(f"__{suffix_of(ac)}" in name for ac in acs):
                err(f"{d['path']}: test {name!r} does not carry {iid}")
            elif not any(re.search(rf"\b{re.escape(name)}\b", t) for t in texts.values()):
                err(f"{d['path']}: test {name!r} not found in any tracked file")
            hm = re.search(r"\bac:([0-9a-f]{8})\b", ev)
            if hm and m.group(2) == "AC":
                if hm.group(1) != hash_of(iid):
                    err(f"{d['path']}: SUSPECT {iid} changed since this record (ac:{hm.group(1)} -> ac:{hash_of(iid)})")
            elif m.group(2) == "AC":
                unhashed += 1
            if result == "pass":
                passing.setdefault(d["fm"].get("parent"), set()).update(acs)
        if unhashed:
            notes.append(f"NOTE {d['path']}: {unhashed} AC row(s) without ac:<hash> in Evidence; suspect detection off for them")

    # d. + g. plans
    in_scope = set()
    for d in docs.values():
        if d["type"] != "plan" or d["fm"].get("status") not in ("open", "resolved"):
            continue
        scope = scope_acs(d)
        in_scope |= scope
        uncovered = sorted(ac for ac in scope if suffix_of(ac) not in carried)
        hard = d["fm"]["status"] == "resolved" and d["id"] not in allowed
        print(f"{d['id']}: CARRIED {len(scope) - len(uncovered)}/{len(scope)}")
        for ac in uncovered:
            if hard:
                err(f"{d['path']}: UNCOVERED no test carries {ac}")
            else:
                notes.append(f"UNCOVERED {d['path']}: no test carries {ac}")
        if d["fm"]["status"] == "resolved":
            for ac in sorted(scope - passing.get(d["id"], set())):
                err(f"{d['path']}: resolved without a passing record row for {ac}")
            for i in d["fm"].get("implements", []):
                m = ITEM_ID.match(i)
                target = by_prefix[m.group(1)]["id"] if m and m.group(1) in by_prefix else i
                if target in stale:
                    err(f"{d['path']}: resolved but implements STALE {target}")

    # f. orphans
    for s, where in sorted(carried.items()):
        try:
            ac = id_of_suffix(s)
        except ValueError:
            ac = None
        if not ac or not item_exists(ac):
            err(f"ORPHANED test id {s} in {', '.join(sorted(where))} names no existing AC")
        elif ac not in in_scope:
            notes.append(f"ORPHANED {ac} is tested in {', '.join(sorted(where))} but in no plan's delivery scope")

    # j. architecture boundaries
    arch = root / "ARCHITECTURE.md"
    if "ARCHITECTURE.md" in files:
        unenforced = 0
        for rule, by in boundary_rows(arch.read_text(encoding="utf-8")):
            by = by.strip("`")
            if by.startswith("Unenforced:"):
                unenforced += 1
            elif not by:
                err(f"ARCHITECTURE.md: boundary {rule!r} has no Enforced by and no Unenforced: reason")
            elif by not in files:
                err(f"ARCHITECTURE.md: boundary {rule!r} enforced by {by}, which is not a tracked file")
        if unenforced:
            notes.append(f"NOTE ARCHITECTURE.md: {unenforced} boundary rule(s) marked Unenforced")

    for n in notes:
        print(n)
    for e in errors:
        print("ERROR", e)
    print("trace-check:", "FAIL" if errors else "OK", f"({len(docs)} docs, {len(carried)} AC ids in tests)")
    return 1 if errors else 0


if __name__ == "__main__":
    top = subprocess.check_output(["git", "rev-parse", "--show-toplevel"], text=True).strip()
    args = sys.argv[1:]
    if args and args[0] == "--impact" and len(args) == 2:
        sys.exit(main(pathlib.Path(top), impact_range=args[1]))
    if args and args[0] != "--hash":
        sys.exit("usage: trace-check [--hash <ac-id>...] | --impact <git range>")
    sys.exit(main(pathlib.Path(top), tuple(args[1:])))
